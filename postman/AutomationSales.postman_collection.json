                  "const t = pm.response.json();",
                  "pm.test(\"one task\", () => pm.expect(t.length).to.eql(1));",
                  "pm.test(\"OPEN, LOW priority (58 days)\", () => { pm.expect(t[0].taskStatus).to.eql(\"OPEN\"); pm.expect(t[0].priority).to.eql(\"LOW\"); });"
