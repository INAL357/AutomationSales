              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"customerId\": {{customerId}},\n  \"salespersonId\": {{salespersonId}},\n  \"licenseQuantity\": 5,\n  \"purchaseDate\": \"{{lastYear}}\",\n  \"expiryDate\": \"{{in5Days}}\"\n}"
