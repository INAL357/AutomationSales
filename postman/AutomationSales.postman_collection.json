            "url": "{{baseUrl}}/api/licenses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"customerId\": {{customerId}},\n  \"salespersonId\": {{salespersonId}},\n  \"licenseQuantity\": 20,\n  \"purchaseDate\": \"{{lastYear}}\",\n  \"expiryDate\": \"{{in58Days}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"licence58Id\", pm.response.json().licenseId);",
                  "pm.test(\"status EXPIRING_SOON\", () => pm.expect(pm.response.json().status).to.eql(\"EXPIRING_SOON\"));",
                  "pm.test(\"58 days remaining\", () => pm.expect(pm.response.json().daysRemaining).to.eql(58));",
                  "pm.test(\"durationMonths calculated\", () => pm.expect(pm.response.json().durationMonths).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Licence expiring in 5 days",
