# Copy this file to ".env" only if your backend is NOT on the same address as the frontend.
#
# Leave it empty during development: vite.config.js forwards /api to http://localhost:8080.
#
# In production, if the API lives on another domain, put its address here (no /api at the end),
# then run "npm run build" again. Example:
# VITE_API_URL=https://api.yourcompany.com
VITE_API_URL=
